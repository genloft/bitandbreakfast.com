# Credenciales y ajustes del entorno: nunca al repositorio (config.ejemplo.php sí)
/config/config.php

# La clave del traductor la escribe el panel, igual que la del buzon.
/config/traductor.php

# El buzon de correo lo escribe el panel y lleva la clave del buzon dentro.
/config/correo.php

# Salida estática generada por cron/publicar.php
/publico/*
!/publico/.gitkeep

# Cachés en disco (robots.txt, feeds)
/cache/*
!/cache/.gitkeep

# Registros locales
*.log

# Basura de sistema y editores
Thumbs.db
.DS_Store
.idea/
.vscode/
*.swp

# Cerrojo del instalador web; lo crea y lo borra el propio instalador
/config/.instalacion
