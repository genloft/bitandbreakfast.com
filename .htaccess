# =============================================================================
#  Bit & Breakfast - configuracion de Apache para la raiz de public_html
#
#  Todo el proyecto vive dentro de public_html, asi que este fichero hace dos
#  trabajos: servir la web estatica de publico/ como si fuera la raiz, y dejar
#  fuera del alcance del navegador todo lo que no es publico.
#
#  Comprueba que funciona pidiendo https://tudominio.com/config/config.php :
#  tiene que devolver 403. Si devuelve el fichero, este .htaccess no se esta
#  aplicando y NO debes subir credenciales al servidor.
# =============================================================================

Options -Indexes
DirectoryIndex index.html index.php

# --- Directorios privados ----------------------------------------------------
RedirectMatch 403 ^/(config|lib|cron|sql|docs|pruebas|plantillas|cache)(/|$)

# Ficheros que nunca deben servirse, esten donde esten.
<FilesMatch "(^\.|\.(sql|md|tsv|log|ini|sh|bak|ejemplo\.php)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# --- La web estatica se sirve desde publico/ ---------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- Sitio sin instalar --------------------------------------------------
    # Mientras no exista config/config.php, cualquier peticion acaba en el
    # instalador. Es lo que hace que un despliegue recien clonado se ponga en
    # marcha solo con abrir el dominio. En cuanto el instalador escribe la
    # configuracion, esta regla deja de cumplirse sola y no vuelve a aplicarse.
    #
    # Estas reglas dan por hecho que el proyecto cuelga de la raiz del dominio,
    # que es como lo despliega hPanel sobre public_html.
    #
    # OJO: entre el despliegue y la instalacion, el formulario lo ve cualquiera
    # que pase por el dominio. Lo normal es que sean minutos, pero si vas a
    # tardar, descomenta las tres lineas siguientes con tu IP y solo tu veras el
    # instalador. La primera condicion las apaga solas en cuanto el sitio queda
    # instalado, para no impedir que instalar.php se borre cuando un despliegue
    # lo devuelva al servidor.
    #
    #   RewriteCond %{DOCUMENT_ROOT}/config/config.php !-f
    #   RewriteCond %{REMOTE_ADDR} !=203.0.113.45
    #   RewriteRule ^instalar\.php$ - [F]

    RewriteCond %{DOCUMENT_ROOT}/config/config.php !-f
    RewriteCond %{DOCUMENT_ROOT}/instalar.php -f
    RewriteCond %{REQUEST_URI} !^/instalar\.php$
    RewriteRule ^ /instalar.php [R=302,L]

    # Instalado pero sin ninguna edicion generada todavia: la portada la
    # contesta index.php, que explica que no hay nada publicado. Sin esto,
    # publico/ vacio daria un 403 seco.
    RewriteCond %{DOCUMENT_ROOT}/publico/index.html !-f
    RewriteRule ^$ index.php [L]

    # publico/ es el almacen de la web generada, no una direccion publica. Sin
    # esto, cada pagina existiria en dos URLs (/bits/x y /publico/bits/x), que
    # para un sitio que se apoya en canonicas y en un RSS es un problema.
    #
    # La condicion mira THE_REQUEST, que es la linea de peticion original y no
    # cambia con las reescrituras internas. Sin ella, la regla volveria a
    # dispararse sobre la reescritura de mas abajo y el sitio entero entraria
    # en un bucle de redirecciones.
    # La segunda condicion cierra la redireccion abierta: con /publico//otro
    # dominio, el destino "/$1" quedaria como "//otrodominio", que en una
    # cabecera Location es una URL a otro sitio, no una ruta de este.
    RewriteCond %{THE_REQUEST} "\s/publico(/|\s)"
    RewriteCond %{REQUEST_URI} !^/publico//
    RewriteRule ^publico(?:/(.*))?$ /$1 [R=301,L]

    # api/ y panel/ son PHP y se sirven tal cual. instalar.php tambien:
    # es el instalador web, y se borra solo en cuanto termina.
    RewriteCond %{REQUEST_URI} !^/(api|panel|publico)/
    RewriteCond %{REQUEST_URI} !^/(robots\.txt|favicon\.ico|feed\.xml|instalar\.php|index\.php)$
    RewriteRule ^(.*)$ publico/$1 [L]

    # Los ficheros de la raiz del sitio generado.
    RewriteRule ^(robots\.txt|favicon\.ico|feed\.xml)$ publico/$1 [L]
</IfModule>

# --- Cabeceras de seguridad --------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # Politica restrictiva: la web no carga nada de terceros. El buscador del
    # archivo y los votos van en ficheros .js propios, nunca en linea.
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"

    # El instalador lleva su hoja de estilos dentro del propio fichero, para
    # poder ejecutarse aunque todavia no haya nada publicado. Se le permite
    # solo a el, y solo el estilo: nunca script.
    <Files "instalar.php">
        Header always set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
    </Files>
</IfModule>

# --- Compresion y cache de la web estatica -----------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/xml application/javascript application/json
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    # El HTML no se cachea: una edicion se puede corregir despues de publicarse.
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
